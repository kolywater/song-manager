<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox is disabled in Phase 1 so we can read the local Dropbox sync
	     folder (~/Library/CloudStorage/Dropbox*) without requiring the user
	     to grant a security-scoped bookmark. Re-enable later by adding the
	     scoped folder access flow back. -->
</dict>
</plist>
